# Copy this file to .env and replace the placeholder values.

# Use the same region for your workspace and API key; this sample uses US East.
# Regions: https://docs.recall.ai/v1.11/docs/regions
RECALL_REGION=us-east-1

# Create an API key in your US East workspace:
# https://us-east-1.recall.ai/dashboard/developers/api-keys
RECALL_API_KEY=YOUR_RECALL_API_KEY

# Run: ngrok http 3000 --url=YOUR_STATIC_DOMAIN.ngrok-free.dev
# Copy its HTTPS forwarding URL below, without a trailing slash.
PUBLIC_API_BASE_URL=https://YOUR_STATIC_DOMAIN.ngrok-free.dev

# Register this URL at https://us-east-1.recall.ai/dashboard/webhooks.
# Subscribe to bot.done for deletion; bot.in_call_recording and bot.fatal are optional.
RECALL_WEBHOOK_URL=https://YOUR_STATIC_DOMAIN.ngrok-free.dev/api/webhook